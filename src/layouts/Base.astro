---
import '../styles/global.css';
import { site, linkWhatsApp } from '../data/site';

interface Props {
  titulo?: string;
  descricao?: string;
  semIndice?: boolean;
}

const { titulo, descricao = site.descricao, semIndice = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${site.nomeCurto}` : `${site.nome} | Eventos em Juiz de Fora`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagemOg = new URL('/img/og.png', Astro.site).href;
const ano = new Date().getFullYear();
const whatsapp = linkWhatsApp('Olá, BobSom! Vim pelo site e gostaria de falar sobre um evento.');

const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nome,
  url: Astro.site?.href,
  logo: new URL('/img/logo-original.svg', Astro.site).href,
  image: imagemOg,
  description: site.descricao,
  telephone: site.telefoneE164,
  foundingDate: String(site.desde),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.cidade,
    addressRegion: site.uf,
    addressCountry: 'BR',
  },
  areaServed: site.regioes.map((name) => ({ '@type': 'City', name })),
  sameAs: [site.instagram, site.facebook].filter(Boolean),
};

const menu = [
  { href: '/servicos/', rotulo: 'Serviços' },
  { href: '/eventos/', rotulo: 'Eventos' },
  { href: '/sobre/', rotulo: 'Sobre' },
  { href: '/avaliar/', rotulo: 'Avaliar' },
];
const atual = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {semIndice ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonica} />}
    <meta name="theme-color" content="#000000" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href="/fonts/michroma-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="largura topo__linha">
        <a class="topo__logo" href="/" aria-label="BobSom Produções, página inicial">
          <img src="/img/logo-palavra.svg" alt="" width="172" height="26" />
        </a>
        <div class="menu">
          <button class="menu__botao" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
            <span></span><span></span><span></span>
          </button>
          <nav id="menu-principal" aria-label="Principal">
            {menu.map((item) => (
              <a href={item.href} aria-current={atual.startsWith(item.href) ? 'page' : undefined}>
                {item.rotulo}
              </a>
            ))}
            <a class="botao botao--pequeno" href="/orcamento/">Pedir orçamento</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="largura rodape__grade">
        <div>
          <img src="/img/logo.svg" alt="BobSom Produções" width="210" height="53" loading="lazy" />
          <p>Produção de eventos desde {site.desde}.<br />{site.bairro}, {site.cidade} - {site.uf}.</p>
        </div>
        <div>
          <h2>Fale com a gente</h2>
          <ul>
            <li><a href={whatsapp} target="_blank" rel="noopener">WhatsApp {site.telefone}</a></li>
            <li><a href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramNome}</a></li>
            {site.facebook && <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>}
            <li><a href={site.fichaGoogleUrl} target="_blank" rel="noopener">Ver no Google Maps</a></li>
          </ul>
        </div>
        <div>
          <h2>Navegue</h2>
          <ul>
            {menu.map((item) => <li><a href={item.href}>{item.rotulo}</a></li>)}
            <li><a href="/orcamento/">Pedir orçamento</a></li>
          </ul>
        </div>
      </div>
      <p class="largura rodape__fim">© {ano} {site.nome}</p>
    </footer>

    <a class="zap" href={whatsapp} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
    </a>

    <script>
      const botao = document.querySelector<HTMLButtonElement>('.menu__botao');
      const nav = document.querySelector<HTMLElement>('#menu-principal');
      botao?.addEventListener('click', () => {
        const aberto = nav?.classList.toggle('aberto') ?? false;
        botao.setAttribute('aria-expanded', String(aberto));
        botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
      });
    </script>
  </body>
</html>
