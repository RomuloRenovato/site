---
import '../styles/global.css';
import Icone from '../components/Icone.astro';
import { site, linkWhatsApp } from '../data/site';

interface Props {
  titulo?: string;
  descricao?: string;
  semIndice?: boolean;
}

const { titulo, descricao = site.descricao, semIndice = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${site.nomeCurto}` : `${site.nome} | Eventos em Juiz de Fora`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagemOg = new URL('/img/og.png', Astro.site).href;
const ano = new Date().getFullYear();
const whatsapp = linkWhatsApp('Olá, BobSom! Vim pelo site e gostaria de falar sobre um evento.');

const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nome,
  url: Astro.site?.href,
  logo: new URL('/img/logo-original.svg', Astro.site).href,
  image: imagemOg,
  description: site.descricao,
  telephone: site.telefoneE164,
  foundingDate: String(site.desde),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.cidade,
    addressRegion: site.uf,
    addressCountry: 'BR',
  },
  areaServed: site.regioes.map((name) => ({ '@type': 'City', name })),
  sameAs: [site.instagram, site.facebook].filter(Boolean),
};

const menu = [
  { href: '/servicos/', rotulo: 'Serviços' },
  { href: '/eventos/', rotulo: 'Eventos' },
  { href: '/sobre/', rotulo: 'Sobre' },
  { href: '/avaliar/', rotulo: 'Avaliar' },
];
const atual = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {semIndice ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonica} />}
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href="/fonts/michroma-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo">
      <div class="largura topo__linha">
        <a class="topo__logo" href="/" aria-label="BobSom Produções, página inicial">
          <img src="/img/logo-palavra.svg" alt="" width="172" height="26" />
        </a>
        <div class="menu">
          <button class="menu__botao" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
            <span></span><span></span><span></span>
          </button>
          <nav id="menu-principal" aria-label="Principal">
            {menu.map((item) => (
              <a href={item.href} aria-current={atual.startsWith(item.href) ? 'page' : undefined}>
                {item.rotulo}
              </a>
            ))}
            <span class="menu__redes">
              <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram da BobSom" title="Instagram">
                <Icone nome="instagram" tamanho={21} />
              </a>
              <a href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp da BobSom" title="WhatsApp">
                <Icone nome="whatsapp" tamanho={21} />
              </a>
            </span>
            <a class="botao botao--pequeno" href="/orcamento/">Pedir orçamento</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="largura rodape__grade">
        <div>
          <img src="/img/logo.svg" alt="BobSom Produções" width="210" height="53" loading="lazy" />
          <p>Produção de eventos desde {site.desde}.</p>
          <ul class="contatos">
            <li>
              <a href={site.fichaGoogleUrl} target="_blank" rel="noopener">
                <Icone nome="mapa" /><span>{site.bairro}, {site.cidade} - {site.uf}</span>
              </a>
            </li>
            <li>
              <a href={whatsapp} target="_blank" rel="noopener">
                <Icone nome="whatsapp" /><span>{site.telefone}</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Redes</h2>
          <ul class="contatos">
            <li>
              <a href={site.instagram} target="_blank" rel="noopener">
                <Icone nome="instagram" /><span>{site.instagramNome}</span>
              </a>
            </li>
            {site.facebook && (
              <li>
                <a href={site.facebook} target="_blank" rel="noopener">
                  <Icone nome="facebook" /><span>Facebook</span>
                </a>
              </li>
            )}
            <li>
              <a href={site.fichaGoogleUrl} target="_blank" rel="noopener">
                <Icone nome="google" /><span>Perfil no Google</span>
              </a>
            </li>
            <li>
              <a href={site.avaliarUrl} target="_blank" rel="noopener">
                <Icone nome="estrela" /><span>Deixar uma avaliação</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Páginas</h2>
          <ul>
            <li><a href="/">Início</a></li>
            {menu.map((item) => <li><a href={item.href}>{item.rotulo}</a></li>)}
            <li><a href="/orcamento/">Pedir orçamento</a></li>
          </ul>
        </div>
      </div>
      <p class="largura rodape__fim">© {ano} {site.nome}</p>
    </footer>

    <a class="zap" href={whatsapp} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">
      <Icone nome="whatsapp" tamanho={28} />
    </a>

    <script>
      const botao = document.querySelector<HTMLButtonElement>('.menu__botao');
      const nav = document.querySelector<HTMLElement>('#menu-principal');
      botao?.addEventListener('click', () => {
        const aberto = nav?.classList.toggle('aberto') ?? false;
        botao.setAttribute('aria-expanded', String(aberto));
        botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
      });
    </script>
  </body>
</html>
