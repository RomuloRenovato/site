---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BlocoAvaliar from '../components/BlocoAvaliar.astro';
import Chamada from '../components/Chamada.astro';
import Clientes from '../components/Clientes.astro';
import Icone from '../components/Icone.astro';
import { fotos } from '../data/fotos';
import { servicosPorGrupo } from '../data/servicos';
import { depoimentos } from '../data/depoimentos';
import { site, linkWhatsApp } from '../data/site';

const tipos = [
  { nome: 'Corporativos', texto: 'Convenções, lançamentos, treinamentos e confraternizações de empresas.', foto: fotos.painelLed },
  { nome: 'Congressos e palestras', texto: 'Auditório, som, telão, transmissão e credenciamento para grandes plateias.', foto: fotos.plateiaPalestrante },
  { nome: 'Feiras e exposições', texto: 'Stands em octanorme, estrutura, iluminação e recepção de visitantes.', foto: fotos.feiraPavilhao },
  { nome: 'Evangélicos e escolares', texto: 'Cultos, conferências, formaturas e celebrações de escolas.', foto: fotos.auditorioPalco },
];

const mosaico = [
  { foto: fotos.palestra, larga: true },
  { foto: fotos.painelLed },
  { foto: fotos.auditorioPalco },
  { foto: fotos.tenda },
  { foto: fotos.salaoAzul },
];

const whatsapp = linkWhatsApp('Olá, BobSom! Vim pelo site e gostaria de falar sobre um evento.');
---

<Base>
  <section class="heroi">
    <div class="heroi__fundo">
      <Image src={fotos.plateiaPalestrante.src} alt="" widths={[640, 1280, 1800]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
    </div>
    <div class="largura">
      <div class="heroi__conteudo">
        <p class="sobretitulo">Produção de eventos em {site.cidade}</p>
        <h1>Som, luz, imagem e estrutura para o seu evento.</h1>
        <p class="lead">
          Eventos corporativos, congressos, palestras e feiras: sonorização, iluminação, painel de LED, transmissão,
          palco, stands, credenciamento, equipe e buffet. Em Juiz de Fora e em toda Minas, desde {site.desde}.
        </p>
        <div class="acoes">
          <a class="botao" href="/orcamento/">Pedir orçamento</a>
          <a class="botao botao--contorno" href={whatsapp} target="_blank" rel="noopener">
            <Icone nome="whatsapp" /> {site.telefone}
          </a>
        </div>
        <ul class="contatos contatos--linha">
          <li>
            <a href={site.instagram} target="_blank" rel="noopener"><Icone nome="instagram" /><span>{site.instagramNome}</span></a>
          </li>
          <li>
            <a href={site.fichaGoogleUrl} target="_blank" rel="noopener"><Icone nome="mapa" /><span>{site.bairro}, {site.cidade}</span></a>
          </li>
          <li>
            <a href={site.fichaGoogleUrl} target="_blank" rel="noopener"><Icone nome="estrela" /><span>5,0 no Google</span></a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="secao" id="servicos">
    <div class="largura">
      <div class="cabeca">
        <h2>Serviços</h2>
        <p class="lead">Contrate um serviço ou o evento inteiro. A mesma equipe cuida da técnica, da estrutura e das pessoas.</p>
      </div>
      <div class="paineis">
        {servicosPorGrupo.map((grupo) => (
          <article class="painel">
            <Image src={grupo.foto.src} alt="" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 590px" format="webp" />
            <h3>{grupo.nome}</h3>
            <p>{grupo.chamada}</p>
            <ul>
              {grupo.servicos.map((s) => (
                <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--escura">
    <div class="largura">
      <div class="cabeca">
        <h2>Tipos de evento</h2>
      </div>
      <div class="tipos">
        {tipos.map((t) => (
          <article class="tipo">
            <Image src={t.foto.src} alt={t.foto.alt} widths={[400, 700]} sizes="(max-width: 900px) 50vw, 290px" format="webp" />
            <div>
              <h3>{t.nome}</h3>
              <p>{t.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="largura">
      <div class="cabeca">
        <h2>Eventos</h2>
      </div>
      <div class="mosaico">
        {mosaico.map(({ foto, larga }) => (
          <figure class={larga ? 'larga' : undefined}>
            <Image src={foto.src} alt={foto.alt} widths={[420, 640, 900]} sizes={larga ? '(max-width: 900px) 100vw, 790px' : '(max-width: 560px) 100vw, 390px'} format="webp" />
          </figure>
        ))}
      </div>
      <div class="acoes" style="margin-top: 28px">
        <a class="botao botao--contorno" href="/eventos/">Ver mais fotos</a>
        <a class="botao botao--contorno" href={site.instagram} target="_blank" rel="noopener">
          <Icone nome="instagram" /> {site.instagramNome}
        </a>
      </div>
    </div>
  </section>

  <Clientes />

  <section class="secao">
    <div class="largura">
      <div class="cabeca">
        <h2>Avaliações no Google</h2>
      </div>
      <ul class="depoimentos">
        {depoimentos.map((d) => (
          <li>
            <p class="nota" aria-label="5 estrelas">★★★★★</p>
            <blockquote>{d.texto}</blockquote>
            <cite>{d.autor}</cite>
          </li>
        ))}
      </ul>
      <div class="acoes" style="margin-top: 32px">
        <a class="botao botao--contorno" href={site.fichaGoogleUrl} target="_blank" rel="noopener">
          <Icone nome="google" /> Ver todas no Google
        </a>
      </div>
    </div>
  </section>

  <BlocoAvaliar />
  <Chamada />
</Base>
