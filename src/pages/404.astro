---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada" semIndice>
  <section class="secao">
    <div class="largura">
      <p class="sobretitulo">Erro 404</p>
      <h1>Essa página saiu do ar.</h1>
      <p class="lead" style="margin-block: 20px 28px">O endereço pode ter mudado. Comece pelos serviços ou peça um orçamento.</p>
      <div class="acoes">
        <a class="botao" href="/orcamento/">Pedir orçamento</a>
        <a class="botao botao--contorno" href="/servicos/">Ver serviços</a>
      </div>
    </div>
  </section>
</Base>
