---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chamada from '../components/Chamada.astro';
import Clientes from '../components/Clientes.astro';
import Heroi from '../components/Heroi.astro';
import { eventos } from '../data/eventos';
import { fotos } from '../data/fotos';
import { site } from '../data/site';

const cidades = [...new Set(eventos.map((e) => e.cidade))];
---

<Base titulo="Eventos realizados em Juiz de Fora e Minas Gerais" descricao={`Eventos produzidos pela BobSom: congressos, seminários, encontros, formaturas e inaugurações em ${cidades.slice(0, 5).join(', ')} e outras cidades.`}>
  <Heroi
    sobretitulo="Eventos"
    titulo="Eventos que produzimos"
    lead={`Congressos, seminários, encontros, formaturas e inaugurações em ${site.cidade} e em cidades como ${cidades.filter((c) => c !== site.cidade).slice(0, 4).join(', ')}.`}
    foto={fotos.escolaFuturoPlateia}
  >
    <div class="acoes">
      <a class="botao botao--contorno" href={site.instagram} target="_blank" rel="noopener">Ver mais no Instagram {site.instagramNome}</a>
    </div>
  </Heroi>

  <section class="secao">
    <div class="largura">
      <div class="eventos-grade">
        {eventos.map((evento) => (
          <figure>
            <Image src={evento.foto.src} alt={evento.foto.alt} widths={[420, 640, 900]} sizes="(max-width: 560px) 100vw, 420px" format="webp" />
            <figcaption>
              <strong>{evento.nome}</strong>
              <span class="eventos-grade__cidade">{evento.cidade}</span>
              {evento.fez && <span>{evento.fez}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Clientes />
  <Chamada titulo="Seu evento pode ser o próximo." />
</Base>
