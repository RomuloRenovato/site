---
import { Image } from 'astro:assets';
import { clientes } from '../data/clientes';
---

{
  clientes.length > 0 && (
    <section class="secao" id="clientes">
      <div class="largura">
        <div class="cabeca">
          <h2>Clientes</h2>
        </div>
        <ul class="clientes">
          {clientes.map((c) => (
            <li>
              {c.imagem && (
                <Image src={c.imagem} alt={c.imagemAlt ?? c.nome} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 380px" format="webp" />
              )}
              <strong>{c.nome}</strong>
              <span>{[c.cidade, c.ano, c.servicos].filter(Boolean).join(' · ')}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
